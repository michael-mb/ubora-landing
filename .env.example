# ─── Site ────────────────────────────────────────────────────────────
# Storyblok access token (Settings → Access Tokens).
#   - « Preview » for development / previews in Storyblok
#   - « Public » for production
# Leave empty: the site uses the local content in app/content.
NUXT_STORYBLOK_TOKEN=

# Storyblok space region: eu | us | ca | ap | cn
NUXT_STORYBLOK_REGION=eu

# draft | published (default: draft in dev, published in production)
NUXT_PUBLIC_STORYBLOK_VERSION=

# Public site URL (canonical / Open Graph tags)
NUXT_PUBLIC_SITE_URL=https://www.uboracapital.com

# ─── Setup script (npm run storyblok:setup) ─────────────────────────
# Space ID (Settings → Space), without the « # » shown by Storyblok
# Personal Access Token (My account → Personal access tokens) — not the Preview token above
STORYBLOK_SPACE_ID=
STORYBLOK_PERSONAL_TOKEN=
