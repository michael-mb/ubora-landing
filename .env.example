# ─── Site ────────────────────────────────────────────────────────────
# Token d'accès Storyblok (Settings → Access Tokens).
#   - « Preview » pour le développement / la prévisualisation dans Storyblok
#   - « Public » pour la production
# Laisser vide : le site utilise le contenu local de app/content.
NUXT_STORYBLOK_TOKEN=

# Région de l'espace Storyblok : eu | us | ca | ap | cn
NUXT_STORYBLOK_REGION=eu

# draft | published (par défaut : draft en dev, published en production)
NUXT_PUBLIC_STORYBLOK_VERSION=

# URL publique du site (balises canonical / Open Graph)
NUXT_PUBLIC_SITE_URL=https://www.uboracapital.com

# Endpoint du formulaire de contact (ex. https://formspree.io/f/xxxx).
# Vide : le formulaire ouvre le client mail du visiteur.
NUXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# ─── Script d'initialisation (npm run storyblok:setup) ───────────────
# ID de l'espace (Settings → Space) et Personal Access Token (My account → Personal access tokens)
STORYBLOK_SPACE_ID=
STORYBLOK_PERSONAL_TOKEN=
