              {
                "type": "text",
                "text": "2. Hosting and server logs"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "This website is hosted by [TO BE COMPLETED: name, address and country of the hosting provider]. Each time you visit, the server automatically records technical information sent by your browser:"
              }
            ]
          },
          {
            "type": "bullet_list",
            "content": [
              {
                "type": "list_item",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
